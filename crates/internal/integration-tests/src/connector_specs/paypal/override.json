    },
    "no3ds_fail_payment": {
      "grpc_req": {
        "shipping_cost": 100,
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4111111111111111"
            },
            "card_holder_name": {
              "value": "CCREJECT-REFUSED"
            }
          }
        },
        "address": {
          "billing_address": {
            "first_name": {
              "value": "CCREJECT-REFUSED"
            },
            "last_name": null
          }
        }
      },
      "assert": {
        "error": {
          "must_exist": true
        },
        "status": {
          "equals": "FAILURE"
        },
        "error.connector_details.code": {
          "equals": "0500"
        },
        "error.connector_details.message": {
          "contains": "DO_NOT_HONOR"
        },
        "error.issuer_details.network_details.decline_code": {
          "equals": "0500"
        }
      }
    },
    "no3ds_auto_capture_przelewy24": {
      "grpc_req": {
