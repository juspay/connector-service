{
  "PaymentService/Authorize": {
    "threeds_frictionless_auto_capture_credit_card": {
      "grpc_req": {
        "merchant_transaction_id": "auto_generate",
        "amount": {
          "minor_amount": 6000,
          "currency": "SGD"
        },
        "order_tax_amount": 0,
        "shipping_cost": 0,
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4333880000200019"
            },
            "card_exp_month": {
              "value": "07"
            },
            "card_exp_year": {
              "value": "2030"
            },
            "card_cvc": {
              "value": "123"
            },
            "card_holder_name": {
              "value": "TEST CARD"
            },
            "card_type": "credit"
          }
        },
        "capture_method": "AUTOMATIC",
        "customer": {
          "name": "auto_generate",
          "email": {
            "value": "auto_generate"
          },
          "id": "auto_generate",
          "phone_number": {
            "value": "auto_generate"
          }
        },
        "address": {},
        "auth_type": "NO_THREE_DS",
        "enrolled_for_3ds": true,
        "return_url": "https://example.com/payment/return",
        "webhook_url": "https://example.com/payment/webhook",
        "description": "AsiaPay 3DS 2.2 frictionless card sale (SGD)",
        "payment_channel": "ECOMMERCE",
        "test_mode": true,
        "locale": "en-US",
        "browser_info": {
          "ip_address": "127.0.0.1",
          "accept_header": "application/json",
          "user_agent": "Mozilla/5.0 (integration-tests)",
          "accept_language": "en-US",
          "color_depth": 24,
          "screen_height": 1080,
          "screen_width": 1920,
          "java_enabled": false,
          "java_script_enabled": true,
          "time_zone_offset_minutes": -480
        }
      },
      "assert": {
        "status": {
          "one_of": ["CHARGED", "PENDING"]
        },
        "error": {
          "must_not_exist": true
        }
      },
      "display_name": "AsiaPay | 3DS 2.2 Frictionless | Automatic Capture (SGD)"
    },
    "hosted_html_returns_pending_redirection": {
      "grpc_req": {
        "merchant_transaction_id": "auto_generate",
        "amount": {
          "minor_amount": 6000,
          "currency": "SGD"
        },
        "order_tax_amount": 0,
        "shipping_cost": 0,
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4333880000200019"
            },
            "card_exp_month": {
              "value": "07"
            },
            "card_exp_year": {
              "value": "2030"
            },
            "card_cvc": {
              "value": "123"
            },
            "card_holder_name": {
              "value": "TEST CARD"
            },
            "card_type": "credit"
          }
        },
        "capture_method": "AUTOMATIC",
        "customer": {
          "name": "auto_generate",
          "email": {
            "value": "auto_generate"
          },
          "id": "auto_generate",
          "phone_number": {
            "value": "auto_generate"
          }
        },
        "address": {},
        "auth_type": "NO_THREE_DS",
        "enrolled_for_3ds": true,
        "return_url": "https://example.com/payment/return",
        "webhook_url": "https://example.com/payment/webhook",
        "description": "AsiaPay hosted HTML returns pending redirection (SGD)",
        "payment_channel": "ECOMMERCE",
        "test_mode": true,
        "locale": "en-US",
        "browser_info": {
          "ip_address": "127.0.0.1",
          "accept_header": "application/json",
          "user_agent": "Mozilla/5.0 (integration-tests)",
          "accept_language": "en-US",
          "color_depth": 24,
          "screen_height": 1080,
          "screen_width": 1920,
          "java_enabled": false,
          "java_script_enabled": true,
          "time_zone_offset_minutes": -480
        }
      },
      "assert": {
        "status": {
          "one_of": ["PENDING"]
        },
        "error": {
          "must_not_exist": true
        }
      },
      "display_name": "AsiaPay | Hosted HTML Returns Pending Redirection (SGD)"
    }
  },
  "PaymentService/Refund": {
    "refund_unsettled_sale_synchronous": {
      "grpc_req": {
        "merchant_refund_id": "auto_generate",
        "connector_transaction_id": "auto_generate",
        "payment_amount": 6000,
        "refund_amount": {
          "minor_amount": 6000,
          "currency": "SGD"
        }
      },
      "assert": {
        "status": {
          "one_of": [
            "REFUND_SUCCESS",
            "PENDING",
            "REFUND_PENDING"
          ]
        },
        "connector_refund_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      },
      "display_name": "AsiaPay | Refund Unsettled Sale Synchronous (SGD)"
    }
  }
}
